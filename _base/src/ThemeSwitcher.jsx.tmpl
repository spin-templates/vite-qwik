import { component$, useSignal, useVisibleTask$ } from '@builder.io/qwik'
import { getThemePref, setTheme } from './theme.js'

const options = [
  { value: 'light', label: 'Light' },
  { value: 'dark', label: 'Dark' },
  { value: 'system', label: 'System' },
]

export const ThemeSwitcher = component$(() => {
  const pref = useSignal('system')

  useVisibleTask$(() => {
    pref.value = getThemePref()
  })

  return (
    <div class="theme-switcher" role="group" aria-label="Color theme">
      {options.map(({ value, label }) => (
        <button
          type="button"
          class={pref.value === value ? 'active' : undefined}
          aria-pressed={pref.value === value}
          onClick$={() => {
            setTheme(value)
            pref.value = value
          }}
        >
          {label}
        </button>
      ))}
    </div>
  )
})